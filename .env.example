# Copia este archivo a `.env` (local) y completa los valores.
# `.env` está en .gitignore: nunca lo subas al repositorio.
#
# En Vercel y Supabase, define las mismas variables en cada entorno
# (Development / Preview / Production) con valores distintos.

# --- Frontend (público; protegido por RLS) --------------------------------
# La anon key es pública por diseño: solo permite lo que permitan las políticas.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Solo scripts locales / administración (SECRETO) ---------------------
# Nunca la incluyas en el frontend ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- Entorno --------------------------------------------------------------
# local | preview | production
APP_ENV=local
